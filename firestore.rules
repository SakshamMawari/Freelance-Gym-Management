rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function ownUser() { return signedIn() && resource.data.uid == request.auth.uid; }
    function ownUserWrite() { return signedIn() && request.resource.data.uid == request.auth.uid; }
    function ownByUserId() { return signedIn() && resource.data.userId == request.auth.uid; }
    function ownByUserIdWrite() { return signedIn() && request.resource.data.userId == request.auth.uid; }

    match /users/{userId} {
      allow read: if signedIn() && (userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && userId == request.auth.uid && request.resource.data.uid == request.auth.uid && request.resource.data.role == 'member';
      allow update: if isAdmin() || (userId == request.auth.uid && request.resource.data.uid == request.auth.uid && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }
    match /memberships/{membershipId} {
      allow read: if isAdmin() || ownByUserId();
      allow create: if isAdmin() || ownByUserIdWrite();
      allow update: if isAdmin() || ownByUserIdWrite();
      allow delete: if isAdmin();
    }
    match /attendance/{attendanceId} {
      allow read: if isAdmin() || ownByUserId();
      allow create: if isAdmin() || ownByUserIdWrite();
      allow update, delete: if isAdmin() || ownByUserId();
    }
    match /payments/{paymentId} {
      allow read: if isAdmin() || ownByUserId();
      allow create: if isAdmin() || ownByUserIdWrite();
      allow update, delete: if isAdmin();
    }
  }
}
